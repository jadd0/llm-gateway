# Gateway
# Loopback by default. Every request needs a gateway API key (npm run keys -- create-key <tenant>).
GATEWAY_HOST=127.0.0.1
GATEWAY_PORT=8080
# Providers. Each base URL carries the API version prefix as the provider's SDK expects; its path is kept.
# OPENAI_BASE_URL must include its path (/v1): a bare http://host:port is refused at start-up, because the
# gateway no longer adds /v1. Pointing it at the mock: http://127.0.0.1:9000/v1
# A provider with no key is not configured: requests for its models get 503 provider_not_configured.
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_VERSION=2023-06-01
ANTHROPIC_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_API_KEY=
# The mock provider, in all three formats (mock-* models; see MODEL_ROUTES). Needs no key.
MOCK_BASE_URL=http://127.0.0.1:9000
# Optional: a separate mock per format (the chaos run kills one and keeps the other). Blank: MOCK_BASE_URL.
MOCK_ANTHROPIC_BASE_URL=
MOCK_GEMINI_BASE_URL=
# Which provider serves a model: prefix=provider pairs, longest prefix wins, unknown model is 400 model_not_found.
# Leave blank for the default:
#   claude-=anthropic,gpt-=openai,o1=openai,o3=openai,o4=openai,gemini-=gemini,
#   mock-anthropic-=mock-anthropic,mock-gemini-=mock-gemini,mock-openai-=mock-openai,mock-=mock-openai
MODEL_ROUTES=
# Max keep-alive sockets to each upstream origin. First bottleneck candidate.
UPSTREAM_CONNECTIONS=256
# Per-attempt limits, by phase: connecting, waiting for response headers (a non-streamed completion only
# sends headers when it is done, so this one is long), and silence in the middle of a body.
UPSTREAM_CONNECT_TIMEOUT_MS=5000
UPSTREAM_HEADERS_TIMEOUT_MS=120000
UPSTREAM_IDLE_TIMEOUT_MS=30000
# Total deadline for one client request: every attempt, backoff and fallback included. A request past it
# is cut with 504; the estimate stays charged only if a provider call may still be billing.
UPSTREAM_MAX_DURATION_MS=240000

# Fallback chains, ';'-separated, models in order with '>' (e.g. claude-fable-5-1>gpt-6-astra). Blank: none.
MODEL_FALLBACKS=
# Retries per model on retryable errors (attempts, not retries), full-jitter backoff, retry-after honoured up to a cap.
RETRY_MAX_ATTEMPTS_PER_MODEL=3
RETRY_BASE_MS=200
RETRY_CAP_MS=2000
RETRY_AFTER_MAX_MS=5000
RETRY_MIN_REMAINING_MS=1000
# Circuit breaker per provider, shared through Redis (local per process while Redis is down).
BREAKER_WINDOW_MS=10000
BREAKER_MIN_FAILURES=5
BREAKER_FAILURE_RATIO=0.5
BREAKER_OPEN_MS=15000
BREAKER_REDIS_TIMEOUT_MS=50
LOG_LEVEL=warn

# Mock provider
MOCK_PORT=9000
MOCK_LATENCY_MS=200
MOCK_TOKEN_DELAY_MS=10
MOCK_COMPLETION_TOKENS=20
MOCK_ERROR_RATE=0

# Postgres (docker compose maps 5436; 5432-5435 are taken by a local Postgres and other projects)
DATABASE_URL=postgres://gateway:gateway@127.0.0.1:5436/llm_gateway
REDIS_URL=redis://127.0.0.1:6379

# Auth
# Server-side secret mixed into every API key hash (HMAC-SHA256). At least 32 characters; the
# gateway refuses to start without it. Changing it invalidates every issued key. Use a real random
# value outside local development.
API_KEY_PEPPER=dev-only-pepper-change-me-0123456789abcdef
# redis: valid keys cached in Redis. none: query Postgres on every request (benchmark comparison only).
AUTH_CACHE=redis
AUTH_CACHE_TTL_S=600
AUTH_NEGATIVE_TTL_S=60
# Longer than AUTH_CACHE_TTL_S so a revoke marker outlives any cached "valid" entry.
AUTH_TOMBSTONE_TTL_S=1200
DB_POOL_SIZE=20
# Prepended to every Redis key; tests set a random one per run.
REDIS_KEY_PREFIX=

# Rate limiting (per API key, token bucket in Redis; needs REDIS_URL)
# false only for benchmarks that isolate other parts of the request path.
RATE_LIMIT_ENABLED=true
# Used for keys with no limit of their own (set per key with `keys set-limits`).
RATE_LIMIT_DEFAULT_RPM=600
RATE_LIMIT_DEFAULT_TPM=200000
# Output tokens assumed when a request has no max_tokens / max_completion_tokens.
RATE_LIMIT_DEFAULT_MAX_TOKENS=1024
# A Redis answer slower than this fails open: the request is served and not limited.
RATE_LIMIT_REDIS_TIMEOUT_MS=50

# Budgets (monthly spend cap per tenant, UTC calendar month; needs REDIS_URL, falls back to Postgres)
BUDGET_ENABLED=true
# Cap for tenants with none of their own (set per tenant with `keys set-budget`). USD, e.g. 10 or 0.5.
BUDGET_DEFAULT_MONTHLY_USD=10
# A reservation not settled within this lapses, so a crashed gateway cannot hold money forever. Must be
# longer than UPSTREAM_MAX_DURATION_MS plus 30 seconds or the gateway refuses to start.
BUDGET_RESERVATION_TTL_S=300
# A Redis answer slower than this sends the budget check to Postgres.
BUDGET_REDIS_TIMEOUT_MS=50
# How often each gateway re-reads the budget epoch from Postgres (one tiny select per interval, not per
# request). The longest an instance can run on an old epoch's balance.
BUDGET_EPOCH_REFRESH_MS=250
# Consecutive failed Redis calls that move budget decisions to Postgres (a failed PING does so at once).
BUDGET_OUTAGE_FAILURES=3

# Response cache (exact match, in Redis; needs REDIS_URL). Only requests with an explicit temperature 0 are
# cached unless CACHE_ALLOW_NONDETERMINISTIC=true. Run Redis with maxmemory-policy volatile-lru so cached
# entries (which all expire) are evicted before keys that never expire (budgets, circuit breaker).
CACHE_ENABLED=true
# How long a cached answer lives.
CACHE_TTL_S=3600
# An answer whose stored JSON is bigger than this is not cached.
CACHE_MAX_ENTRY_BYTES=262144
# true: cache requests with any (or no) temperature, not only temperature 0.
CACHE_ALLOW_NONDETERMINISTIC=false
# Identical non-streamed misses: the first goes upstream holding a Redis lock for at most this long, the
# others wait for its answer for at most CACHE_WAIT_MS (not longer than the lock) and then go upstream.
CACHE_LOCK_MS=30000
CACHE_WAIT_MS=10000
# A Redis answer slower than this skips the cache for that request (header x-gateway-cache: unavailable).
CACHE_REDIS_TIMEOUT_MS=50
# A cached answer replayed as a stream is cut into content chunks of this many characters.
CACHE_REPLAY_CHUNK_CHARS=64

# Request log. Each request becomes one entry in a Redis stream; the log worker (npm run worker) writes
# them to Postgres in batches. Metadata only, never prompt or completion text. Run Redis with AOF
# (docker-compose.yml does) so queued entries, which now include settled spend, survive a Redis restart.
# stream: queue to Redis. inline: one awaited Postgres insert per request, for the logging benchmark only.
LOG_MODE=stream
# The worker's consumer group on the stream.
LOG_GROUP=log-writers
# Entries per Postgres transaction, and the longest the worker waits for a batch to fill (ms).
LOG_BATCH_SIZE=500
LOG_BATCH_WAIT_MS=1000
# An entry another worker read and never acknowledged is taken over after this long (ms).
LOG_CLAIM_IDLE_MS=30000
# An entry delivered this many times without being applied is moved to the dead-letter stream.
LOG_MAX_DELIVERIES=5
# Request-log entries the gateway keeps in memory while Redis is down; past this they are dropped and
# counted. Spend is never held here: it goes to Postgres directly while Redis is down.
LOG_BUFFER_MAX=10000
# How often the worker charges the estimate of holds whose settle never arrived (seconds).
LOG_SWEEP_S=60
# This worker's name in the consumer group. Unset: hostname-pid.
# WORKER_CONSUMER=
