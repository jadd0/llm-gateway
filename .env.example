# Gateway
# Loopback by default. Every request needs a gateway API key (npm run keys -- create-key <tenant>).
GATEWAY_HOST=127.0.0.1
GATEWAY_PORT=8080
# Providers. Each base URL carries the API version prefix as the provider's SDK expects; its path is kept.
# OPENAI_BASE_URL must include its path (/v1): a bare http://host:port is refused at start-up, because the
# gateway no longer adds /v1. Pointing it at the mock: http://127.0.0.1:9000/v1
# An upstream mounted at the root of its host (no path): set OPENAI_BASE_URL_ALLOW_ROOT=true.
# A provider with no key is not configured: requests for its models get 503 provider_not_configured.
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_BASE_URL_ALLOW_ROOT=false
OPENAI_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_VERSION=2023-06-01
ANTHROPIC_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_API_KEY=
# The mock provider, in all three formats (mock-* models; see MODEL_ROUTES). Needs no key.
MOCK_BASE_URL=http://127.0.0.1:9000
# Optional: a separate mock per format (the chaos run kills one and keeps the other). Blank: MOCK_BASE_URL.
MOCK_ANTHROPIC_BASE_URL=
MOCK_GEMINI_BASE_URL=
# Which provider serves a model: prefix=provider pairs, longest prefix wins, unknown model is 400 model_not_found.
# Leave blank for the default:
#   claude-=anthropic,gpt-=openai,o1=openai,o3=openai,o4=openai,gemini-=gemini,
#   mock-anthropic-=mock-anthropic,mock-gemini-=mock-gemini,mock-openai-=mock-openai,mock-=mock-openai
MODEL_ROUTES=
# Max keep-alive sockets to each upstream origin. First bottleneck candidate.
UPSTREAM_CONNECTIONS=256
# Per-attempt limits, by phase: connecting, waiting for response headers (a non-streamed completion only
# sends headers when it is done, so this one is long), and silence in the middle of a body.
UPSTREAM_CONNECT_TIMEOUT_MS=5000
UPSTREAM_HEADERS_TIMEOUT_MS=120000
UPSTREAM_IDLE_TIMEOUT_MS=30000
# Total deadline for one client request: every attempt, backoff and fallback included. A request past it
# is cut with 504; the estimate stays charged only if a provider call may still be billing.
UPSTREAM_MAX_DURATION_MS=240000
# A provider's error answer is waited for this long for its body once its status and headers are in; a
# slower body is dropped (status kept) and the request moves on to the next attempt or model.
UPSTREAM_ERROR_BODY_TIMEOUT_MS=2000
# At most this many bytes of a provider's error body are kept; the rest is dropped unread and the connection closed.
UPSTREAM_ERROR_BODY_MAX_BYTES=65536

# Fallback chains, ';'-separated, models in order with '>' (e.g. claude-fable-5-1>gpt-6-astra). Blank: none.
MODEL_FALLBACKS=
# Retries per model on retryable errors (attempts, not retries), full-jitter backoff, retry-after honoured up to a cap.
RETRY_MAX_ATTEMPTS_PER_MODEL=3
RETRY_BASE_MS=200
RETRY_CAP_MS=2000
RETRY_AFTER_MAX_MS=5000
RETRY_MIN_REMAINING_MS=1000
# Circuit breaker per provider, shared through Redis (local per process while Redis is down).
BREAKER_WINDOW_MS=10000
BREAKER_MIN_FAILURES=5
BREAKER_FAILURE_RATIO=0.5
BREAKER_OPEN_MS=15000
BREAKER_REDIS_TIMEOUT_MS=50
LOG_LEVEL=warn

# Mock provider
MOCK_PORT=9000
MOCK_LATENCY_MS=200
MOCK_TOKEN_DELAY_MS=10
MOCK_COMPLETION_TOKENS=20
MOCK_ERROR_RATE=0

# Postgres (docker compose maps 5436; 5432-5435 are taken by a local Postgres and other projects)
DATABASE_URL=postgres://gateway:gateway@127.0.0.1:5436/llm_gateway
REDIS_URL=redis://127.0.0.1:6379

# Auth
# Server-side secret mixed into every API key hash (HMAC-SHA256). At least 32 characters; the
# gateway refuses to start without it. Changing it invalidates every issued key. Use a real random
# value outside local development.
API_KEY_PEPPER=dev-only-pepper-change-me-0123456789abcdef
# redis: valid keys cached in Redis. none: query Postgres on every request (benchmark comparison only).
AUTH_CACHE=redis
AUTH_CACHE_TTL_S=600
AUTH_NEGATIVE_TTL_S=60
# Longer than AUTH_CACHE_TTL_S so a revoke marker outlives any cached "valid" entry.
AUTH_TOMBSTONE_TTL_S=1200
DB_POOL_SIZE=20
# Prepended to every Redis key; tests set a random one per run.
REDIS_KEY_PREFIX=

# Failed authentications one client address may make per minute; past it the address gets 429 before any
# key lookup (only failures count, a valid key hands its token back). 0 turns it off. Needs REDIS_URL.
AUTH_FAIL_LIMIT_PER_MIN=30
# Addresses or CIDRs (comma-separated) whose X-Forwarded-For is believed; any other peer is limited by its
# own socket address. 'none' trusts nobody. Behind nginx on the same host: 127.0.0.1.
TRUSTED_PROXIES=127.0.0.1

# Rate limiting (per API key, token bucket in Redis; needs REDIS_URL)
# false only for benchmarks that isolate other parts of the request path.
RATE_LIMIT_ENABLED=true
# Used for keys with no limit of their own (set per key with `keys set-limits`).
RATE_LIMIT_DEFAULT_RPM=600
RATE_LIMIT_DEFAULT_TPM=200000
# Output tokens the rate limiter's TPM estimate assumes when a request has no max_tokens / max_completion_tokens.
# Separate from the per-model output defaults (what is sent to a provider and held for the budget).
RATE_LIMIT_DEFAULT_MAX_TOKENS=1024
# Output tokens a request with no max_tokens may generate on a mock-* model that is forwarded without a limit; the
# budget hold for such a request is sized on it (real OpenAI models use their documented maximum).
MOCK_MAX_OUTPUT_TOKENS=4096
# A Redis answer slower than this fails open: the request is served and not limited.
RATE_LIMIT_REDIS_TIMEOUT_MS=50

# Budgets (monthly spend cap per tenant, UTC calendar month; needs REDIS_URL, falls back to Postgres)
BUDGET_ENABLED=true
# Cap for tenants with none of their own (set per tenant with `keys set-budget`). USD, e.g. 10 or 0.5.
BUDGET_DEFAULT_MONTHLY_USD=10
# A reservation not settled within this lapses, so a crashed gateway cannot hold money forever. Must be
# longer than UPSTREAM_MAX_DURATION_MS plus 30 seconds or the gateway refuses to start.
BUDGET_RESERVATION_TTL_S=300
# A Redis answer slower than this sends the budget check to Postgres.
BUDGET_REDIS_TIMEOUT_MS=50
# How often each gateway re-reads the budget epoch from Postgres (one tiny select per interval, not per
# request). The longest an instance can run on an old epoch's balance.
BUDGET_EPOCH_REFRESH_MS=250
# Consecutive failed Redis calls that move budget decisions to Postgres (a failed PING does so at once).
BUDGET_OUTAGE_FAILURES=3

# Response cache (exact match, in Redis; needs REDIS_URL). Only requests with an explicit temperature 0 are
# cached unless CACHE_ALLOW_NONDETERMINISTIC=true. Run Redis with maxmemory-policy volatile-lru so cached
# entries (which all expire) are evicted before keys that never expire (budgets, circuit breaker).
CACHE_ENABLED=true
# How long a cached answer lives.
CACHE_TTL_S=3600
# An answer whose stored JSON is bigger than this is not cached.
CACHE_MAX_ENTRY_BYTES=262144
# true: cache requests with any (or no) temperature, not only temperature 0.
CACHE_ALLOW_NONDETERMINISTIC=false
# Identical non-streamed misses: the first goes upstream holding a short Redis lock, which it renews every
# third of this for as long as its request is open. A leader that dies frees the lock within this long; one
# whose request closed without a fill is dropped after twice this.
CACHE_LOCK_MS=5000
# How often a request waiting on a leader in another process looks at the cached entry and the lock. No entry
# and no lock, or a Redis that does not answer, sends it upstream at once. Requests waiting on a leader in the
# same process do not poll.
CACHE_POLL_MS=250
# The most anyone waits for one leader's answer. At least
# CACHE_LOCK_MS, at most UPSTREAM_MAX_DURATION_MS (both checked when the cache is on).
CACHE_WAIT_MS=120000
# A Redis answer slower than this skips the cache for that request (header x-gateway-cache: unavailable).
CACHE_REDIS_TIMEOUT_MS=50
# A cached answer replayed as a stream is cut into content chunks of this many characters.
CACHE_REPLAY_CHUNK_CHARS=64

# Semantic cache (needs the response cache above and Postgres with the pgvector extension). OFF for every tenant until
# it opts in (npm run keys -- set-semantic-cache <tenant> on): a similar prompt is not the same prompt. After an exact
# miss, the last user message is embedded and compared with the prompts of cached answers; a close enough one that
# also passes the guards below serves its answer.
# Only the last user message may differ: the model, system prompt, earlier turns and every parameter must match.
SEMANTIC_ENABLED=true
# Cosine similarity at or above which a stored prompt's answer is served. Provisional: the threshold is chosen
# from the labelled evaluation (npm run bench:semantic-eval), which has not been run yet.
SEMANTIC_THRESHOLD=0.95
# Must be 1024: semantic_cache.embedding is vector(1024).
SEMANTIC_DIMENSIONS=1024
# Voyage API (voyage-4-lite). Blank key: every lookup uses the local model.
VOYAGE_API_KEY=
VOYAGE_BASE_URL=https://api.voyageai.com/v1
VOYAGE_MODEL=voyage-4-lite
SEMANTIC_VOYAGE_TIMEOUT_MS=300
# The local model (voyage-4-nano, same embedding space) in Ollama: docker compose up -d ollama ollama-pull.
OLLAMA_URL=http://127.0.0.1:11434
SEMANTIC_LOCAL_MODEL=hf.co/MongoDB/voyage-4-nano-GGUF:Q8_0
SEMANTIC_LOCAL_TIMEOUT_MS=200
# true: a query made by one model may match a vector made by the other. false: same model only. Provisional
# false until the cross-model evaluation says otherwise.
SEMANTIC_CROSS_MODEL=false
# none: embed the text bare. query: put the model's query prompt in front. Decided by the evaluation.
SEMANTIC_INPUT_TYPE=none
# A last user message longer than this is not embedded; that request skips the semantic step.
SEMANTIC_MAX_INPUT_CHARS=2000
# The nearest-neighbour query's time budget; slower is a miss.
SEMANTIC_PG_TIMEOUT_MS=100
# Connections of the pool the semantic cache's lookups use, apart from the main pool.
SEMANTIC_PG_POOL=4
# Connections of the pool its fills, removals and cleanup use: a burst of fills queues there, never in front of a lookup.
SEMANTIC_PG_FILL_POOL=2
# Guards a similar prompt must pass before its answer is served. Numbers and IDs, quoted strings, names and
# negation words must agree (always on). This one also requires the content words to nearly agree: the two
# prompts' word sets may differ by at most SEMANTIC_GUARD_MAX_DIFF words (symmetric difference).
SEMANTIC_GUARD_TOKENSET=true
SEMANTIC_GUARD_MAX_DIFF=2
# Fills waiting to be embedded; a full queue drops the new one (counted in the logs).
SEMANTIC_FILL_QUEUE=1000
# How often expired rows are deleted from Postgres.
SEMANTIC_CLEANUP_S=300

# Request log. Each request becomes one entry in a Redis stream; the log worker (npm run worker) writes
# them to Postgres in batches. Metadata only, never prompt or completion text. Run Redis with AOF
# (docker-compose.yml does) so queued entries, which now include settled spend, survive a Redis restart.
# stream: queue to Redis. inline: one awaited Postgres insert per request, for the logging benchmark only.
LOG_MODE=stream
# The worker's consumer group on the stream.
LOG_GROUP=log-writers
# Entries per Postgres transaction, and the longest the worker waits for a batch to fill (ms).
LOG_BATCH_SIZE=500
LOG_BATCH_WAIT_MS=1000
# An entry another worker read and never acknowledged is taken over after this long (ms).
LOG_CLAIM_IDLE_MS=30000
# An entry delivered this many times without being applied is moved to the dead-letter stream.
LOG_MAX_DELIVERIES=5
# Request-log entries the gateway keeps in memory while Redis is down; past this they are dropped and
# counted. Spend is never held here: it goes to Postgres directly while Redis is down.
LOG_BUFFER_MAX=10000
# How often the worker charges the estimate of holds whose settle never arrived, and drops Redis holds with no
# Postgres row (seconds). Runs on its own timer, under traffic too.
LOG_SWEEP_S=60
# A hold is charged its estimate only this long after it lapsed, so a settle queued before it lapsed has been
# applied by then (seconds). Set it above your worst worker lag.
LOG_SWEEP_GRACE_S=60
# Approximate cap on the request-log stream (XADD MAXLEN ~). Past it the oldest log entries are dropped, so a
# worker outage cannot fill Redis; the worker warns at 80%. Spend entries are in their own stream and never capped.
LOG_STREAM_MAX=1000000
# A Redis budget hold with no Postgres hold row is dropped once it is this far past its expiry (seconds).
BUDGET_ORPHAN_GRACE_S=600
# This worker's name in the consumer group. Unset: hostname-pid.
# WORKER_CONSUMER=

# Dashboard rollups (written by the log worker in the same transaction as the log rows)
# An hour is folded from per-minute rollups into per-hour rollups once it ended this long ago (minutes).
ROLLUP_FOLD_AFTER_MIN=90
# Folded per-minute rollups are deleted after this many hours (at least 25: the dashboard's 24 h range reads them).
ROLLUP_MINUTE_RETENTION_H=48

# Dashboard (npm run dashboard). It reads its own variables only, never the gateway's.
# Admin token the login form is checked against, at least 32 characters. The dashboard refuses to start without it.
DASHBOARD_TOKEN=
# Secret the session cookie is signed with, at least 32 characters, different from the token.
DASHBOARD_SESSION_SECRET=
# Connection as the read-only role. `npm run db:migrate` creates the login named here (user and password) as a member of
# dashboard_reader when this variable is set; it can read rollups, tenant names and a few request-log columns, nothing else.
# Format: postgres://<login>:<password>@<host>:<port>/<database>, with a login and password of your own choosing.
DASHBOARD_DATABASE_URL=
DASHBOARD_PORT=3200

