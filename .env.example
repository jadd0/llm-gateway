# Gateway
GATEWAY_PORT=8080
# Comma-free single upstream for Days 1-2; provider registry grows on Day 3+.
OPENAI_BASE_URL=http://127.0.0.1:9000
OPENAI_API_KEY=mock-key
# Max keep-alive sockets to each upstream origin. First bottleneck candidate.
UPSTREAM_CONNECTIONS=256
UPSTREAM_TIMEOUT_MS=30000
LOG_LEVEL=warn

# Mock provider
MOCK_PORT=9000
MOCK_LATENCY_MS=200
MOCK_TOKEN_DELAY_MS=10
MOCK_COMPLETION_TOKENS=20
MOCK_ERROR_RATE=0

# Postgres (docker compose maps 5436; 5432-5435 are taken by a local Postgres and other projects)
DATABASE_URL=postgres://gateway:gateway@127.0.0.1:5436/llm_gateway
REDIS_URL=redis://127.0.0.1:6379
