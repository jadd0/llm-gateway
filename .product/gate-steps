# product-kit gate-steps.node v1 — from umbo 0f95e4fa
#
# Read by scripts/gate.sh: one step per line, name<TAB>command, run in order from the repo root;
# the first failure skips the rest. Add a repo-specific step as a new line, never by editing gate.sh.
# Lines starting "#<flag>=<value># " are kept by /product init only when that flag matches, and
# the prefix is removed; a step whose npm script does not exist is deleted, not left to fail.
own-database	node scripts/assert-own-database.mjs
db-migrate	npm run --silent db:migrate
typecheck	npm run --silent typecheck
test	npm run --silent test
check-diagrams	node scripts/check-diagrams.mjs
