{
  "name": "llm-gateway",
  "private": true,
  "type": "module",
  "workspaces": ["packages/*"],
  "engines": { "node": ">=24" },
  "scripts": {
    "dev:mock": "npm run start -w @llm-gateway/mock-provider",
    "dev:gateway": "npm run start -w @llm-gateway/gateway",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm test",
    "bench:baseline": "bash bench/run-baseline.sh",
    "db:migrate": "npm run db:migrate -w @llm-gateway/gateway",
    "keys": "npm run keys -w @llm-gateway/gateway --",
    "smoke:providers": "node --env-file-if-exists=.env.local scripts/smoke-providers.ts",
    "bench:providers": "bash bench/run-providers.sh",
    "bench:chaos": "bash bench/run-chaos.sh",
    "bench:cache": "bash bench/run-cache.sh",
    "bench:semantic-eval": "node --env-file-if-exists=.env.local bench/semantic/eval.ts",
    "bench:vector-index": "node --env-file-if-exists=.env.local bench/semantic/index-bench.ts",
    "bench:semantic": "bash bench/run-semantic.sh"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
