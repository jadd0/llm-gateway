{
  "name": "llm-gateway",
  "private": true,
  "type": "module",
  "workspaces": ["packages/*"],
  "engines": { "node": ">=24" },
  "scripts": {
    "dev:mock": "npm run start -w @llm-gateway/mock-provider",
    "dev:gateway": "npm run start -w @llm-gateway/gateway",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p packages/dashboard/tsconfig.json --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm test",
    "bench:baseline": "bash bench/run-baseline.sh",
    "db:migrate": "npm run db:migrate -w @llm-gateway/gateway",
    "keys": "npm run keys -w @llm-gateway/gateway --",
    "smoke:providers": "node --env-file-if-exists=.env.local scripts/smoke-providers.ts",
    "bench:providers": "bash bench/run-providers.sh",
    "bench:chaos": "bash bench/run-chaos.sh",
    "bench:cache": "bash bench/run-cache.sh",
    "bench:logging": "bash bench/run-logging.sh",
    "worker": "node --env-file-if-exists=.env.local packages/log-worker/src/worker.ts",
    "dashboard": "npm run dev -w @llm-gateway/dashboard",
    "bench:dashboard": "node --env-file-if-exists=.env.local bench/dashboard/query-bench.ts"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
